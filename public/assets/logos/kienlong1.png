			-webkit-filter: blur(0);
			filter: blur(0)
		}

		.fancybox-type-iframe {
			min-height: 560px;
			z-index: 9999;
			background: #fff;
			box-shadow: 0 0 6px rgba(0, 0, 0, .5);
			border-radius: 3px
		}

		.fancybox-type-iframe .fancybox-skin,
		.fancybox-outer,
		.fancybox-inner {
